PORTFOLIO_CONTACT_EMAIL=
# Owner-provided public profile URLs; the application only renders the exact approved profiles.
PORTFOLIO_LINKEDIN_URL=https://www.linkedin.com/in/jackson-severino-da-rocha/
PORTFOLIO_GITHUB_URL=https://github.com/jacksonsr451
# Optional path relative to storage/app/private; only an explicitly approved, valid PDF is served.
PORTFOLIO_RESUME_PATH=
PORTFOLIO_RESUME_APPROVED=false
